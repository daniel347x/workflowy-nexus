{
  "manifest_version": 3,
  "name": "NEXUS for Workflowy",
  "version": "3.54.0",
  "key": "",
  "description": "Workflowy context management, with your agents",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://workflowy.com/*",
    "https://*.workflowy.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://workflowy.com/*",
        "https://*.workflowy.com/*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://workflowy.com/*",
        "https://*.workflowy.com/*"
      ],
      "css": ["katex/katex.min.css", "katex-overrides.css", "glimpse-md-render.css", "glimpse-ui.css"],
      "js": ["hotkeys-shared.js", "marked.min.js", "katex/katex.min.js", "marked-katex-init.js", "glimpse-md-render.js", "glimpse-ui.js", "glimpse-ui-help.js", "glimpse-ui-drawers.js", "glimpse-cache-client.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["katex/fonts/*"],
      "matches": ["https://workflowy.com/*", "https://*.workflowy.com/*"]
    }
  ]
}
